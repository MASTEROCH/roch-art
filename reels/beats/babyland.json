        },
        {
          "do": "tap",
          "target": "text:+ В праздник",
          "target_en": "text:+ Add",
          "hold_ms": 1300
        },
        {
          "do": "eval",
          "value": "var b=[].slice.call(document.querySelectorAll('main button')).filter(function(x){return /^\\+\\s*\\S/.test(x.innerText.trim());})[0];var r=b.getBoundingClientRect(),d=r.top+r.height/2-560,y0=scrollY,t0=performance.now();await new Promise(function(res){(function s(){var k=Math.min(1,(performance.now()-t0)/600),e=k<.5?4*k*k*k:1-Math.pow(-2*k+2,3)/2;scrollTo(0,y0+d*e);if(k<1)requestAnimationFrame(s);else res();})();});return 1",
          "hold_ms": 200
        },
        {
          "do": "tap",
          "target": "text:+ В праздник",
          "target_en": "text:+ Add",
          "hold_ms": 1500
        }
