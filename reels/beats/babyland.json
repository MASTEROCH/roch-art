        {
          "do": "eval",
          "value": "scrollTo(0,0);var c=[].slice.call(document.querySelectorAll('main button')).filter(function(b){return b.innerText.trim().indexOf('🎆')===0;})[0];c.scrollIntoView({inline:'center',block:'nearest'});c.click();await new Promise(function(r){setTimeout(r,900);});await Promise.all([].slice.call(document.querySelectorAll('main img')).map(function(i){return i.complete?1:new Promise(function(r){i.onload=i.onerror=r;setTimeout(r,5000);});}));scrollTo(0,0);return 1",
          "hold_ms": 900
        }
      ],
